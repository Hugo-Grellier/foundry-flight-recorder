# Copy to .env (never commit it). Used by `npm run collector` (optional collector).
# Append-only key, visible to players' browsers. Generate: openssl rand -hex 24
FFR_INGEST_KEY=change-me
# Exact origin(s) players use to open Foundry, comma separated (scheme://host[:port]).
FFR_ALLOWED_ORIGINS=https://foundry.example.org
FFR_RETENTION_DAYS=180
FFR_MAX_DB_MB=2048
FFR_SESSION_IDLE_MIN=240
# 1 only when the collector sits behind a reverse proxy that sets X-Forwarded-For.
FFR_TRUST_PROXY=0
# Host directory for the database (outside Foundry's Data directory!).
FFR_DATA_DIR=../data
